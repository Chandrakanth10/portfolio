{
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  // theckp.com is the site's address. Routes would turn workers.dev off by default; it stays
  // on so links shared before the move still work.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "theckp.com", "custom_domain": true },
    { "pattern": "www.theckp.com", "custom_domain": true }
  ],
  // worker/index.js runs first and holds theckp.com back until LAUNCH_AT; empty means held.
  "main": "worker/index.js",
  "vars": {
    "LAUNCH_AT": "2026-11-24T05:05:00-08:00"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
